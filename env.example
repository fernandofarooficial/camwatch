# .env — CamWatch
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser subido para o GitHub.

DB_USER=camwatch_user
DB_PASSWORD=senha_forte_aqui
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=camwatch

SECRET_KEY=gere-uma-chave-aleatoria-aqui

# Telegram — deixe vazio para desabilitar notificações
TELEGRAM_BOT_TOKEN=

# Checker
CHECKER_WORKERS=80
CHECKER_LOOP_SLEEP=10
CHECKER_TIMEOUT_SEC=10
